{
  "name": "worldbound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worldbound — a smart content engine for live events. Perspective-based, audio-reactive content generation with baked 3D screen mapping (nDisplay-style).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test:lyrics": "node --experimental-strip-types scripts/test-lyric-pack.mjs",
    "test:prompt": "node --experimental-strip-types scripts/test-prompt-look.mjs",
    "gen:demo-track": "node scripts/generate-demo-track.mjs",
    "encode-server": "node scripts/encode-server.mjs",
    "gpu-worker": "node scripts/gpu-worker.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "mp4-muxer": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
